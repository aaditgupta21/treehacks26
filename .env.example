# Team Brain environment variables
# Copy to .env and fill in your keys

# --- Elasticsearch (optional - for persistent storage) ---
# From Elastic Cloud: cloud.elastic.co → your deployment → Copy Elasticsearch URL and API key
ELASTIC_CLOUD_ID=
ELASTIC_API_KEY=

# Or for self-hosted / local:
# ELASTIC_URL=http://localhost:9200
# ELASTIC_API_KEY=

# --- JINA embeddings (optional - for semantic knowledge search) ---
# From jina.ai
JINA_API_KEY=

# --- Server ---
# PORT=8000
# ENVIRONMENT=development
