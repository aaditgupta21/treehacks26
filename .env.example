# Team Brain environment variables
# Copy to .env and fill in your keys

# --- Elasticsearch (optional - for persistent storage) ---
# Option 1: Full URL (same as curl) - most reliable
# ELASTIC_URL=https://your-deployment.es.region.gcp.elastic.cloud:443
# ELASTIC_API_KEY=your_api_key

# Option 2: Cloud ID from Elastic Cloud console
# ELASTIC_CLOUD_ID=
# ELASTIC_API_KEY=

# --- JINA embeddings (optional - for semantic knowledge search) ---
# From jina.ai
JINA_API_KEY=

# --- Server ---
# PORT=8000
# ENVIRONMENT=development

# --- Text-to-PR (register_project + request_code_change) ---
# Required for Brain to write code and open PRs. Get key at console.anthropic.com
# ANTHROPIC_API_KEY=
# GITHUB_TOKEN=   # GitHub PAT with repo scope (push + create PR)
# CLAUDE_CODING_MODEL=claude-sonnet-4-5   # optional; default is claude-sonnet-4-5
